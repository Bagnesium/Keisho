      "module": "diagnostics",
      "function": "run_scenario",
      "args": [
        {
          "ops": [
            {
              "op": "update",
              "id": "a",
              "text": "old alpha"
            },
            {
              "op": "update",
              "id": "b",
              "text": "keep beta"
            },
            {
              "op": "update",
              "id": "a",
              "text": "new gamma"
            },
            {
              "op": "restart"
            },
            {
              "op": "search",
              "query": "keep"
            },
            {
              "op": "search",
              "query": "old"
            }
          ],
          "select": [
            "searches",
            "documents",
            "stored_chunks",
            "orphans"
          ]
        }
      ],
      "expected": {
        "searches": [
          [
            {
              "doc_id": "b",
              "text": "keep beta"
            }
          ],
          []
        ],
        "documents": {
          "a": {
            "version": 2,
            "chunks": 1
          },
          "b": {
            "version": 1,
            "chunks": 1
          }
        },
        "stored_chunks": 2,
        "orphans": 0
      }
    },
