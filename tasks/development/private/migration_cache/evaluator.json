      "function": "run_scenario",
      "args": [
        {
          "configs": [
            {
              "version": 2,
              "endpoint": "local-service",
              "request": {
                "timeout_ms": 1000,
                "max_attempts": 1
              }
            },
            {
              "version": 2,
              "endpoint": "local-service",
              "request": {
                "timeout_ms": 1000,
                "max_attempts": 4
              }
            }
          ],
          "select": [
            "modern"
          ]
        }
      ],
      "expected": {
        "modern": [
          {
            "endpoint": "local-service",
            "timeout_ms": 1000,
            "max_attempts": 1
          },
          {
            "endpoint": "local-service",
            "timeout_ms": 1000,
            "max_attempts": 4
          }
        ]
      }
    },
